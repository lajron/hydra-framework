#!/bin/sh
# Best-effort private knowledge-index and object query store refresh after a
# commit rewrite (`git commit --amend`, or each step of `git rebase`). Git
# has already updated the worktree and index by the time this hook runs, so
# the rewritten commit pairs this hook receives on stdin do not matter here;
# drain them so Git never blocks writing to a hook that ignores its input.
# `ref store rebuild --if-exists` only acts once someone has built the store
# at least once -- opt-in first build, self-maintaining after, mirroring how
# hook-reindex-knowledge already works here.
set -e

cat >/dev/null

root=$(git rev-parse --show-toplevel)
script="$root/.hydra-framework/scripts/hydra.py"

[ -f "$script" ] || exit 0

python3 "$script" hook-reindex-knowledge --if-exists >/dev/null 2>&1 || true
python3 "$script" ref store rebuild --if-exists >/dev/null 2>&1 || true
